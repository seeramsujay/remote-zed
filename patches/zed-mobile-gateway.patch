+fn unregister_event_stream(device_id: &str, stream_id: u64, cx: &mut App) {
+    let streams = &mut cx.global_mut::<MobileGatewayEvents>().streams;
+    if streams
+        .get(device_id)
+        .is_some_and(|stream| stream.id == stream_id)
+    {
+        streams.remove(device_id);
+    }
+}

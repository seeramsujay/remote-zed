+fn permitted_bind(address: IpAddr) -> bool {
+    if address.is_loopback() {
+        return true;
+    }
+    match address {
+        IpAddr::V4(address) => {
+            let octets = address.octets();
+            octets[0] == 100 && (64..=127).contains(&octets[1])
+        }
+        IpAddr::V6(address) => {
+            let segments = address.segments();
+            segments[..3] == [0xfd7a, 0x115c, 0xa1e0]
+        }
+    }
+}
